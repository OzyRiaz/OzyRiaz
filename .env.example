# ---------- Mode ----------
# demo  = in-memory data + simulated payments. No external accounts needed. Never use for real customers.
# live  = Supabase + Stripe. Requires every variable below.
APP_MODE=demo
# Local: http://localhost:3000. Once feastquarter.co.uk is bought and connected, set https://feastquarter.co.uk
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign demo-mode session cookies (demo mode only). Generate: openssl rand -hex 32
DEMO_SESSION_SECRET=change-me-demo-only

# ---------- Supabase (live mode) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose to the browser. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=menu-images

# ---------- Stripe (use TEST keys until legal/finance sign-off) ----------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID of the £4.99/month FeastQuarter Plus recurring price on the PLATFORM account.
# Optional: if empty, the price is created inline from the admin-set membership price.
STRIPE_MEMBERSHIP_PRICE_ID=

# ---------- Email (optional; nothing is sent when empty) ----------
RESEND_API_KEY=
# Use a domain you have verified with your email provider, e.g. "FeastQuarter <orders@feastquarter.co.uk>" once DNS is set up
EMAIL_FROM="FeastQuarter <orders@your-verified-domain.example>"
ADMIN_NOTIFY_EMAIL=

# ---------- Cron ----------
# Shared secret for /api/cron/daily-summary (called by the Netlify scheduled function)
CRON_SECRET=
