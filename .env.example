# ---------- Mode ----------
# demo  = in-memory data + simulated payments. No external accounts needed. Never use for real customers.
# live  = Supabase + Stripe. Requires every variable below.
APP_MODE=demo
# Local: http://localhost:3000. Once feastquarter.co.uk is bought and connected, set https://feastquarter.co.uk
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign demo-mode session cookies (demo mode only). Generate: openssl rand -hex 32
DEMO_SESSION_SECRET=change-me-demo-only

# ---------- Supabase (live mode) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose to the browser. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=menu-images

# ---------- Stripe (use TEST keys until legal/finance sign-off) ----------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint for "Your account" events (checkout, charges, subscriptions)
STRIPE_WEBHOOK_SECRET=
# Signing secret of the SEPARATE webhook endpoint for "Connected accounts" events (account.updated, payout.*)
STRIPE_CONNECT_WEBHOOK_SECRET=
# true = restaurant becomes settlement merchant (its name on card statements). Default false = FeastQuarter. Only REQUIRED for cross-region accounts.
STRIPE_USE_ON_BEHALF_OF=false
# Price ID of the £4.99/month FeastQuarter Plus recurring price on the PLATFORM account.
# Optional: if empty, the price is created inline from the admin-set membership price.
STRIPE_MEMBERSHIP_PRICE_ID=

# ---------- Email (optional; nothing is sent when empty) ----------
RESEND_API_KEY=
# Use a domain you have verified with your email provider, e.g. "FeastQuarter <orders@feastquarter.co.uk>" once DNS is set up
EMAIL_FROM="FeastQuarter <orders@your-verified-domain.example>"
ADMIN_NOTIFY_EMAIL=

# ---------- Cron ----------
# Shared secret for /api/cron/daily-summary (called by the Netlify scheduled function)
CRON_SECRET=

# ---------- Order handling ----------
# Minutes before a paid, unanswered order triggers a reminder + admin alert, and before it is auto-declined and refunded in full
ORDER_ESCALATE_MINUTES=5
ORDER_TIMEOUT_MINUTES=12
# Take a restaurant offline automatically after it lets an order expire (true by default)
ORDER_TIMEOUT_GOES_OFFLINE=true

# ---------- Optional SMS backup (CHARGEABLE: needs owner approval; off by default) ----------
SMS_BACKUP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Couriers ----------
# All third-party couriers are disabled at launch. A subsidy is only ever applied if this is true AND an amount is configured.
COURIER_SUBSIDY_AUTHORISED=false

# Menu import (optional). Reading photos/PDFs with AI costs money and stays OFF until you switch it on.
# Pasting menu text works without any of this.
ANTHROPIC_API_KEY=
MENU_IMPORT_AI_ENABLED=false
MENU_IMPORT_MODEL=claude-opus-5-5
MENU_IMPORT_DAILY_LIMIT=15
